#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files with real keys (commit only env/example.json)
/env/*.json
!/env/example.json

# Generated from dart-defines at build time (iOS)
/ios/Flutter/DartDefines.xcconfig
/ios/Flutter/Environment-*.xcconfig

# Golden test failures
**/failures/

# Android release signing (never commit)
/android/key.properties
*.jks
*.keystore

# Service configuration supplied locally; public examples contain placeholders only.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
.env
.env.*
!.env.example
*.p8
*.p12
*.pfx
*.pem
*.mobileprovision

