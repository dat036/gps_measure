  "fixed_sql": [
    {
      "name": "measurements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"measurements\" (\"id\" TEXT NOT NULL, \"name\" TEXT NULL, \"name_lower\" TEXT NULL, \"type\" INTEGER NOT NULL, \"status\" INTEGER NOT NULL, \"notes\" TEXT NULL, \"area_m2\" REAL NULL, \"perimeter_m\" REAL NULL, \"distance_m\" REAL NULL, \"duration_sec\" INTEGER NULL, \"point_count\" INTEGER NOT NULL DEFAULT 0, \"segment_count\" INTEGER NOT NULL DEFAULT 0, \"is_closed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_closed\" IN (0, 1)), \"self_intersects\" INTEGER NOT NULL DEFAULT 0 CHECK (\"self_intersects\" IN (0, 1)), \"map_style\" INTEGER NOT NULL, \"display_area_unit\" INTEGER NULL, \"display_distance_unit\" INTEGER NULL, \"unit_price\" REAL NULL, \"unit_price_currency\" TEXT NULL, \"unit_price_area\" INTEGER NULL, \"thumbnail_path\" TEXT NULL, \"min_lat\" REAL NULL, \"min_lng\" REAL NULL, \"max_lat\" REAL NULL, \"max_lng\" REAL NULL, \"walk_state\" INTEGER NULL, \"walk_started_at\" TEXT NULL, \"walk_elapsed_sec\" INTEGER NULL, \"walk_last_resume_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"saved_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "measure_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"measure_points\" (\"id\" TEXT NOT NULL, \"measurement_id\" TEXT NOT NULL REFERENCES measurements (id) ON DELETE CASCADE, \"order_index\" INTEGER NOT NULL, \"segment_index\" INTEGER NOT NULL DEFAULT 0, \"lat\" REAL NOT NULL, \"lng\" REAL NOT NULL, \"altitude\" REAL NULL, \"accuracy\" REAL NULL, \"speed\" REAL NULL, \"bearing\" REAL NULL, \"timestamp\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
